{
  "name": "@local/aurora-studio",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "description": "High-freedom UI studio for DeepSeek Harness: palettes, wallpapers and an agent desktop pet.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lion-1209/aurora-studio.git"
  },
  "homepage": "https://github.com/Lion-1209/aurora-studio",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
